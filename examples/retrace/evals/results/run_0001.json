      "diff": "--- a/stg_orders.sql\n+++ b/stg_orders.sql\n@@ -1,9 +1,24 @@\n -- Adapted from Project Blackbox (https://github.com/alejandro-publius/blackbox-datahub), Apache-2.0. Modified for Retrace.\n+-- Fix: payment_processor='cloudpay_v2' emits order_ts in local time (UTC-7), not UTC as the\n+-- raw_orders contract requires. This mis-timezoning shifted orders across calendar-day\n+-- boundaries (inflating some days, deflating others) once cloudpay_v2 launched on 2026-08-06.\n+-- Scoped correction: add 7 hours to cloudpay_v2 timestamps only, to recover true UTC order_ts\n+-- (and therefore the correct order_day) before any other rows are affected.\n CREATE OR REPLACE TABLE staging.stg_orders AS\n SELECT\n     order_id,\n-    CAST(order_ts AS TIMESTAMP) AS order_ts,\n-    CAST(CAST(order_ts AS TIMESTAMP) AS DATE) AS order_day,\n+    CASE\n+        WHEN payment_processor = 'cloudpay_v2'\n+            THEN CAST(order_ts AS TIMESTAMP) + INTERVAL '7 hours'\n+        ELSE CAST(order_ts AS TIMESTAMP)\n+    END AS order_ts,\n+    CAST(\n+        CASE\n+            WHEN payment_processor = 'cloudpay_v2'\n+                THEN CAST(order_ts AS TIMESTAMP) + INTERVAL '7 hours'\n+            ELSE CAST(order_ts AS TIMESTAMP)\n+        END AS DATE\n+    ) AS order_day,\n     customer_id,\n     currency,\n     CAST(amount AS DOUBLE) AS amount,\n",
